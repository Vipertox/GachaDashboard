{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gacha Dashboard",
  "version": "0.1.0",
  "identifier": "de.vipertox.gachadashboard",
  "build": {
    "beforeDevCommand": "npx vite",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gacha Dashboard",
        "width": 480,
        "height": 860,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
